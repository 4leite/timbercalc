{
  "name": "my-tanstack-app",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "check": "pnpm format:check && pnpm lint && pnpm tsc",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "dev": "vite dev --port 3000",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "start": "vite preview --strictPort",
    "typegen": "wrangler types",
    "tsc": "tsc --pretty",
    "playwright": "playwright test -c test/playwright.config.ts",
    "prepare": "simple-git-hooks",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "pnpm vitest run",
    "test:e2e": "pnpm playwright",
    "test:e2e:smoke": "pnpm playwright --project smoke",
    "validate": "pnpm lint && pnpm tsc && pnpm test:unit && pnpm test:e2e",
    "vitest": "vitest  -c test/vitest.config.ts",
    "wrangler": "wrangler"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@radix-ui/react-icons": "^1.3.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "@tohuhono/ui": "^0.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint-plugin-better-tailwindcss": "^4.6.0",
    "jsdom": "^28.1.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.70.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm format"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
